import numpy as np
import theano
import theano.tensor as T
import lasagne

M = 10
N_BATCH = 6

# Number of units in the hidden recurrent layer
N_RECURRENT = 4
# Number of units in the hidden layer
N_HIDDEN = M
# Optimization learning rate
LEARNING_RATE = .001
# How often should we check the output?
EPOCH_SIZE = 100
# Number of epochs to train the net
NUM_EPOCHS = 10

def gen_data(n_batch=N_BATCH, M=M):
    # X : np.ndarray
    #   Input to the network of shape(n_batch, length)
    # y : np.ndarray
    #   Correct output for each sample  of shape (n_batch,)
    X = np.random.uniform(size=(n_batch, M, 1))
    y = np.ones((n_batch,))
    return (X.astype(theano.config.floatX), y.astype(theano.config.floatX))


def squared_nonlin(x):
    return x * x

def main(num_epochs=NUM_EPOCHS):
    print "Building network ..."

    l_in = lasagne.layers.InputLayer(shape=(N_BATCH, M, 1))
    
    l_rnn = lasagne.layers.RecurrentLayer(
        incoming=l_in, 
        num_units=N_RECURRENT, 
        W_in_to_hid=lasagne.init.HeUniform(), 
        W_hid_to_hid=lasagne.init.HeUniform(), 
        nonlinearity=lasagne.nonlinearities.rectify
    )

    print (l_rnn.input_shapes, l_rnn.output_shape)
    l_hidden = lasagne.layers.DenseLayer(
        incoming=l_rnn,
        num_units=N_HIDDEN,
        W=lasagne.init.HeUniform(),
        nonlinearity=squared_nonlin
    )
    print (l_hidden.input_shape, l_hidden.output_shape)
    # output nonlinarity -- identity ???
    # output num_units = 1 ???
    l_out = lasagne.layers.DenseLayer(
        incoming=l_hidden,
        num_units=1,
        W=lasagne.init.HeUniform(),
        nonlinearity=lasagne.nonlinearities.identity
    )
    print (l_out.input_shape, l_out.output_shape) 
    target_values = T.vector('target_output')
    
    # lasagne.layers.get_output produces a variable 
    #                     for the output of the net
    network_output = lasagne.layers.get_output(l_out)

    # The network output will have shape (n_batch, 1); 
    # let's flatten to get a 1-dimensional vector 
    #                              of predicted values
    predicted_values = network_output.flatten()
    
    # Our cost will be mean-squared error
    cost = T.mean((predicted_values - target_values)**2)
    
    # Retrieve all parameters from the network
    all_params = lasagne.layers.get_all_params(l_out)
    
    print "Computing updates ..."
    # Compute SGD updates for training
    updates = lasagne.updates.sgd(cost, all_params, LEARNING_RATE)

    print "Compiling functions ..." 
    # Theano functions for training and computing cost
    train = theano.function(
        [l_in.input_var, target_values], 
        cost, updates=updates
    )

    compute_cost = theano.function(
        [l_in.input_var, target_values], cost
    )

    # We'll use this "validation set" to periodically check progress
    X_val, y_val = gen_data()

    print "Training ..."
    try: 
        for epoch in range(num_epochs):
            for _ in range(EPOCH_SIZE):
                X, y = gen_data()
                train(X, y)
            cost_val = compute_cost(X_val, y_val)
            print "Epoch %d validation cost = %f" % (epoch, cost_val)
    except KeyboardInterrupt:
        pass

if __name__ == '__main__':
    main()

    
