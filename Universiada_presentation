\begin{frame}{Постановка задачи}
Пусть даны изображения $f_1, f_2, \ldots, f_N$, а также изображение $g$. Требуется найти проекцию изображения $g$ на конус $V_F$~--- выпуклую оболочку  $f_1,\, \ldots,\, f_N$, т.\,е. $V_F = \left\{ \sum_{i=1}^N z_i f_i \;\middle|\; z_i \geqslant 0,\ i=1,\, \ldots,\, N \right\}$.
\vspace*{2mm}

Обозначим $F$ матрицу, элементы которой~--- координаты $f_1, f_2, \ldots, f_N$ в некотором ортонормированном базисе пространства изображений $\R^n$
\vspace*{2mm}

Задача проецирования $g$ на конус $V_F$ -- это задача квадратичного программирования:
\vspace*{-2mm}
\begin{columns}[T] % align columns
\begin{column}{.42\textwidth}
\color{red}\rule{\linewidth}{0pt}
\begin{equation*}
	\begin{cases}
	\frac{1}{2}\norm{g - \sum_{i=1}^N z_i f_i}^2 \sim 	\min_{z_i} \\
	z_i \geq 0, \;\; i = 1, ..., N
	\end{cases}
\end{equation*}
\end{column}

\begin{column}{.01\textwidth}
\color{black}\rule{\linewidth}{0pt}
\vspace{0.2cm}
\begin{equation*}
\hspace{-0.5cm}
\Leftrightarrow
\end{equation*}
\end{column}

\begin{column}{.42\textwidth}
\color{blue}\rule{\linewidth}{0pt}
\begin{equation*}
	\begin{cases}
	G(z) = \frac{1}{2} z^T M z + q^T z \sim \min_{z}\\
	z \geq 0\\
	\end{cases}
\end{equation*}
\end{column}%
\end{columns}
\vspace{-0.4cm}
\hspace{4.8cm}
\scalebox{0.65}{% 
$M = F^T F$}

\hspace{4.8cm}
\scalebox{0.65}{%
$q = - F^T g$}
\end{frame}


\begin{frame}{Итерационный алгоритм}
\textcolor{red}{$$z^{r+1} =[(I - \omega M) z^r - \omega q]^+$$}
   
    Выбор $\omega$ ограничивается условием:
    $$[2 (\omega I)^{-1} - M] \mbox{ ~--- положительно определенная матрица}$$
    Или, что то же самое, $$\min\lambda(2 (\omega I)^{-1}) > \max\lambda (M) \Leftrightarrow 0 < \omega < \frac{2}{\max\lambda(M)},$$
    где $\lambda(2 (\omega I)^{-1})$ и $\lambda(M)$~--- спектры матриц $2 (\omega I)^{-1}$ и $M$.
\end{frame}


