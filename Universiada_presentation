\begin{frame}{Метод проекции градиента}
\textcolor{red}{$$z^{r+1} = \max\{0, \;\;[(I - \omega F^T F) z^r + \omega F^T g]\}$$}
   
    Выбор $\omega$ ограничивается условием:
    $$0 < \omega < \frac{2}{\max\lambda(F^T F)},$$
    где $\lambda(F^T F)$~--- спектр матрицы $(F^T F)$.
\end{frame}


