\begin{frame}{Обучение сети}
\hspace{-0.6cm}{\small$
loss = \sum\limits_{i=1}^L s_i\; [\;\norm{ M^{-1/2} (F^T g^{(i)} - M z_*^{(i)}) }^2 + \norm{g}^2 - \norm{(F^T F)^{-1/2} F^T g}^2] \sim \min\limits_{F, M}$}%

\hspace{1.5cm}$
	s_i = 
	\begin{cases}
		\;\;\;1, \;\; g^{(i)} \in V_{F, M}\\
		-1, \;\; g^{(i)} \notin V_{F, M}
	\end{cases},\tab i = 1, ..., L
$

\hspace{1.5cm}$L - \text{объем обучающей выборки}$
